# ============================================================================
# AStockPursue Environment Configuration
# ============================================================================
# Run: bash setup.sh  (interactive setup wizard)
#   or: copy this file to .env and edit manually

# --- JWT Secret (keep this persistent, do not change after deployment) ---
# JWT_SECRET=auto-generated

# --- LLM Provider ---
# Supported: openai, openrouter, deepseek, moonshot, ollama, gemini, groq
LANGCHAIN_PROVIDER=openai
LANGCHAIN_MODEL_NAME=gpt-4o-mini

# --- API Keys (uncomment and fill in your keys) ---
# OpenAI
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (alternative)
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local, no key needed)
# LANGCHAIN_PROVIDER=ollama
# LANGCHAIN_MODEL_NAME=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# CORS origins (comma-separated, leave empty to allow all in dev)
# CORS_ORIGINS=

# Model parameters
LANGCHAIN_TEMPERATURE=0.0
TIMEOUT_SECONDS=120
MAX_RETRIES=2

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AStockPursue
DB_USER=postgres
# DB_PASSWORD_ENC + DB_ENCRYPTION_KEY are generated by setup.sh
# Session storage: "pg" (PostgreSQL) or "file" (filesystem)
SESSION_STORE=pg
# Pool tuning (optional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# --- User Config Encryption Key (generated by setup.sh) ---
# USER_CONFIG_ENCRYPTION_KEY=auto-generated

# --- Admin User (created on first startup) ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Redis Cache (L0) ---
# Redis is optional — if unavailable the system falls back to PG+Parquet+API.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Data Sources ---
# Configure Tushare token via Web UI Settings — stored in DB (encrypted, per-user).
# Below is only a global fallback for dev mode (no login).
# TUSHARE_TOKEN=your-token
# OKX_API_KEY=your-key
# OKX_SECRET_KEY=your-secret
# OKX_PASSPHRASE=your-passphrase
